{
	"schemaVersion": 1,
	"id": "nickname",
	"version": "${version}",
	"name": "nickname",
	"description": "게임 안에서 플레이어 닉네임을 변경하고 저장합니다.",
	"authors": [
		"illbann"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/nickname/icon.png",
	"environment": "*",
